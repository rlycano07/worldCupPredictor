<div class="champion-popup-backdrop" role="presentation">
    <section class="champion-popup" role="dialog" aria-modal="true" aria-labelledby="champion-title" aria-live="polite">
        <button class="champion-close" type="button" @onclick="OnClose" aria-label="Close champion popup">x</button>
        <img class="champion-trophy" src="images/world-cup-trophy.svg" alt="" aria-hidden="true" />
        <div class="champion-copy">
            <p class="eyebrow">Champion</p>
            <h2 id="champion-title">@Champion.Name</h2>
            <p>@Champion.Name wins your World Cup prediction.</p>
        </div>
        <div class="champion-actions">
            <button class="secondary-action" @onclick="OnStartAgain">Start Again</button>
            <button class="secondary-action" @onclick="OnEditGroups">Edit Group Stage</button>
            <button class="primary-action" @onclick="ShowSharePanel">Share Prediction</button>
        </div>

        @if (IsSharePanelVisible)
        {
            <div class="share-panel">
                <p>Share this URL to let them view your prediction.</p>
                <div class="share-url-row">
                    <input class="share-url-field"
                           value="@ShareUrl"
                           readonly
                           aria-label="Prediction share URL"
                           @onclick="SelectShareUrl" />
                    <button class="secondary-action share-copy-action" @onclick="CopyShareUrl">
                        @(HasCopied ? "Copied" : "Copy")
                    </button>
                </div>
                <div class="share-copy-status @(HasCopied ? "visible" : null)" role="status" aria-live="polite">
                    Link copied to clipboard.
                </div>
            </div>
        }
    </section>
</div>

@code {
    [Parameter, EditorRequired] public Team Champion { get; set; } = default!;
    [Parameter, EditorRequired] public string ShareUrl { get; set; } = string.Empty;
    [Parameter] public EventCallback OnStartAgain { get; set; }
    [Parameter] public EventCallback OnEditGroups { get; set; }
    [Parameter] public EventCallback OnShare { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private bool IsSharePanelVisible { get; set; }
    private bool HasCopied { get; set; }
    private string? LastShareUrl { get; set; }

    protected override void OnParametersSet()
    {
        if (ShareUrl != LastShareUrl)
        {
            LastShareUrl = ShareUrl;
            HasCopied = false;
        }
    }

    private void ShowSharePanel()
    {
        IsSharePanelVisible = true;
        HasCopied = false;
    }

    private async Task CopyShareUrl()
    {
        await OnShare.InvokeAsync();
        HasCopied = true;
    }

    private void SelectShareUrl()
    {
        HasCopied = false;
    }
}
