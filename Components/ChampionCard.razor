<section class="champion-card" aria-live="polite">
    <div class="trophy" aria-hidden="true">🏆</div>
    <div>
        <p class="eyebrow">Champion</p>
        <h2>@Champion.Name</h2>
    </div>
    <div class="champion-actions">
        <button class="secondary-action" @onclick="OnStartAgain">Start Again</button>
        <button class="secondary-action" @onclick="OnEditGroups">Edit Group Stage</button>
        <button class="primary-action" @onclick="OnShare">Share Prediction</button>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public Team Champion { get; set; } = default!;
    [Parameter] public EventCallback OnStartAgain { get; set; }
    [Parameter] public EventCallback OnEditGroups { get; set; }
    [Parameter] public EventCallback OnShare { get; set; }
}
