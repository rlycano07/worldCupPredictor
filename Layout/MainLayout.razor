@inherits LayoutComponentBase
@inject PredictionStateService PredictionState
@inject ThemeService Theme

<div class="app-shell">
    <AppHeader />
    <main>
        @Body
    </main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await PredictionState.InitializeAsync();
        await Theme.InitializeAsync();
    }
}
