@page "/"
@inject NavigationManager Navigation
@inject PredictionStateService PredictionState

<PageTitle>World Cup Predictor</PageTitle>

<section class="hero">
    <div class="hero-copy">
        <p class="eyebrow">Client-side bracket builder</p>
        <h1>World Cup Predictor</h1>
        <p>
            Rank every group, generate a Round of 32 bracket, and click your way through
            the knockout rounds until your champion lifts the trophy.
        </p>
        <button class="primary-action" @onclick="StartPrediction">Start Prediction</button>
    </div>
    <div class="hero-board">
        <img class="world-cup-art" src="images/world-cup-trophy.svg" alt="Stylized World Cup trophy" />
        <div class="hero-stats" aria-label="Tournament format">
        <div class="hero-score">
            <span>Groups</span>
            <strong>12</strong>
        </div>
        <div class="hero-score">
            <span>Teams</span>
            <strong>48</strong>
        </div>
        <div class="hero-score">
            <span>Champion</span>
            <strong>1</strong>
        </div>
        </div>
    </div>
</section>

@code {
    private async Task StartPrediction()
    {
        await PredictionState.ResetAllAsync();
        Navigation.NavigateTo("/groups");
    }
}
