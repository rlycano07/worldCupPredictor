@page "/knockout"
@implements IDisposable
@inject PredictionStateService PredictionState
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime

<PageTitle>Knockout Stage - World Cup Predictor</PageTitle>

<section class="page-heading">
    <div>
        <p class="eyebrow">Step 2 of 2</p>
        <h1>Pick the Knockout Winners</h1>
        <p>Click a team in each matchup to move it forward. Changing an earlier pick clears affected later picks.</p>
    </div>
</section>

@if (Champion is not null && !IsChampionPopupDismissed)
{
    <ChampionCard Champion="Champion" OnStartAgain="StartAgain" OnEditGroups="EditGroups" OnShare="SharePrediction" OnClose="DismissChampionPopup" />
}

<KnockoutBracket Rounds="Rounds" />

@code {
    private List<KnockoutRound> Rounds { get; set; } = [];
    private bool IsChampionPopupDismissed { get; set; }
    private string? LastChampionId { get; set; }
    private Team? Champion => PredictionState.GetChampion();

    protected override async Task OnInitializedAsync()
    {
        PredictionState.Changed += RefreshBracket;
        await PredictionState.InitializeAsync();

        if (TryGetShareStateFromQuery(out var sharedState) && sharedState is not null)
        {
            await PredictionState.TryApplyShareStateAsync(sharedState);
        }

        if (!PredictionState.AreGroupsComplete())
        {
            Navigation.NavigateTo("/groups");
            return;
        }

        RefreshBracket();
    }

    private void RefreshBracket()
    {
        Rounds = PredictionState.GetBracket();
        UpdateChampionPopupState();
        StateHasChanged();
    }

    private void UpdateChampionPopupState()
    {
        var championId = Champion?.Id;
        if (championId != LastChampionId)
        {
            LastChampionId = championId;
            IsChampionPopupDismissed = championId is null;
        }
    }

    private async Task StartAgain()
    {
        await PredictionState.StartAgainAsync();
        Navigation.NavigateTo("/");
    }

    private void EditGroups() => Navigation.NavigateTo("/groups");

    private void DismissChampionPopup() => IsChampionPopupDismissed = true;

    private async Task SharePrediction()
    {
        var shareUrl = PredictionState.CreateShareUrl(Navigation.BaseUri);
        await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", shareUrl);
    }

    private bool TryGetShareStateFromQuery(out string? sharedState)
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries);

        foreach (var entry in query)
        {
            var parts = entry.Split('=', 2);
            if (parts.Length == 2 && parts[0] == "p")
            {
                sharedState = Uri.UnescapeDataString(parts[1].Replace("+", " "));
                return !string.IsNullOrWhiteSpace(sharedState);
            }
        }

        sharedState = null;
        return false;
    }

    public void Dispose() => PredictionState.Changed -= RefreshBracket;
}
